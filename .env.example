POMO_HOST=127.0.0.1
POMO_PORT=8000
# Set to false to disable manual developer display commands.
POMO_DEV_CONTROLS=true
# Browser capture constraints; decoded images must not exceed these dimensions.
POMO_CAMERA_WIDTH=640
POMO_CAMERA_HEIGHT=480
POMO_CAMERA_FPS=10
POMO_CAMERA_JPEG_QUALITY=0.75
POMO_CAMERA_MAX_BYTES=524288
# Deadline for body/decode and idle timeout after a successful frame.
POMO_CAMERA_TIMEOUT_SECONDS=3
# Time to grant browser permission and deliver the first frame.
POMO_CAMERA_STARTUP_SECONDS=30
# Optional absolute path; default is models/face_landmarker.task in this repo.
# POMO_CAMERA_MODEL_PATH=/absolute/path/to/face_landmarker.task
