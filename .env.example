POMO_HOST=127.0.0.1
POMO_PORT=8000
# Set to false to disable manual developer display commands.
POMO_DEV_CONTROLS=true
# Browser capture constraints; decoded images must not exceed these dimensions.
POMO_CAMERA_WIDTH=640
POMO_CAMERA_HEIGHT=480
POMO_CAMERA_FPS=10
POMO_CAMERA_JPEG_QUALITY=0.75
POMO_CAMERA_MAX_BYTES=524288
# Deadline for body/decode and idle timeout after a successful frame.
POMO_CAMERA_TIMEOUT_SECONDS=3
# Time to grant browser permission and deliver the first frame.
POMO_CAMERA_STARTUP_SECONDS=30
# Optional absolute path; default is models/face_landmarker.task in this repo.
# POMO_CAMERA_MODEL_PATH=/absolute/path/to/face_landmarker.task
# Sustained-absence policy (seconds); grace must not exceed absence duration.
POMO_TRACKING_LOSS_GRACE_SECONDS=1
POMO_ABSENCE_SECONDS=10
POMO_RETURN_SECONDS=0.5
POMO_OBSERVATION_MAX_AGE_SECONDS=1
# MediaPipe thresholds (not per-frame confidence scores).
POMO_PERCEPTION_DETECTION_CONFIDENCE=0.5
POMO_PERCEPTION_PRESENCE_CONFIDENCE=0.5
POMO_PERCEPTION_TRACKING_CONFIDENCE=0.5
# Grayscale mean 0–255 and Laplacian variance; heuristics need camera tuning.
POMO_PERCEPTION_MIN_BRIGHTNESS=35
POMO_PERCEPTION_MAX_BRIGHTNESS=230
POMO_PERCEPTION_MIN_BLUR_VARIANCE=15
# Automatic head direction relative to the camera.
POMO_PERCEPTION_YAW_DEGREES=30
POMO_PERCEPTION_PITCH_DEGREES=25
POMO_PERCEPTION_HYSTERESIS_DEGREES=5
